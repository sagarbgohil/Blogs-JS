<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>New Contact Submission</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
            rel="stylesheet"
        />
    </head>

    <body style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif;">
        <div style="background-color: #f6f9f8; max-width: 600px; margin: auto; padding: 40px 30px;">
            <h2 style="color: #134e4a; margin-bottom: 20px;">New Contact Form Submission</h2>

            <p style="margin: 10px 0;"><strong>Name:</strong> {{name}}</p>
            <p style="margin: 10px 0;"><strong>Email:</strong> {{email}}</p>
            <p style="margin: 10px 0;"><strong>Phone:</strong> {{phone}}</p>
            <p style="margin: 10px 0;"><strong>Service Interested:</strong> {{service}}</p>
            <p style="margin: 10px 0;"><strong>Message:</strong><br />{{message}}</p>

            <hr style="margin: 30px 0;" />

            <footer style="font-size: 14px; color: #555;">
                <p>This message was sent from the contact form on <a href="https://sagargohil.dev">SagarGohil.dev</a></p>
            </footer>
        </div>
    </body>
</html>